{% liquid
  assign text_content_block = blank
  assign collection_card_count = 0
  for section_block in section.blocks
    if section_block.type == 'text_content'
      assign text_content_block = section_block
    else
      assign collection_card_count = collection_card_count | plus: 1
    endif
  endfor

  assign has_text_content = false
  if text_content_block != blank
    if text_content_block.settings.heading != blank or text_content_block.settings.subtitle != blank or text_content_block.settings.button_label != blank
      assign has_text_content = true
    endif
  endif

  assign text_heading_tag = 'h2'
  if section.settings.heading != blank
    assign text_heading_tag = 'h3'
  endif

  assign text_align_items = 'flex-start'
  if text_content_block.settings.text_align == 'center'
    assign text_align_items = 'center'
  elsif text_content_block.settings.text_align == 'right'
    assign text_align_items = 'flex-end'
  endif

  assign card_title_size_desktop = section.settings.title_size | times: 0.275
  assign card_title_size_mobile = section.settings.title_size | times: 0.2375
  assign size_heading = section.settings.heading_size | times: settings.heading_base_size | times: 0.000225
  assign columns_mobile = section.settings.columns_mobile | plus: 0
  assign columns_desktop = section.settings.columns_desktop | plus: 0
  assign swiper_on_mobile = section.settings.swiper_on_mobile 
  if collection_card_count <= columns_mobile
    assign swiper_on_mobile = false
  endif
  assign enable_desktop_slider = section.settings.enable_desktop_slider
  if collection_card_count <= columns_desktop
    assign enable_desktop_slider = false
  endif
  if has_text_content
    assign swiper_on_mobile = false
    assign enable_desktop_slider = false
  endif
  assign ratio = 100
  if section.settings.image_ratio == 'rectangle'
    assign ratio = 150
  endif
  if section.settings.image_ratio == 'landscape'
    assign ratio = 75
  endif
  if section.settings.image_ratio == '3/4'
    assign ratio = 133 
  endif
  if settings.lang_direction contains request.locale.iso_code
    assign is_rtl = true
    assign class_rtl = "margin-left"
  else
    assign is_rtl = false
    assign class_rtl = "margin-right"
  endif
  assign arrow_swipe_mobile = false
  if swiper_on_mobile and section.settings.enable_arrow_mobile
    assign arrow_swipe_mobile = true
  endif
%}
{%- style -%}
  .section-padding-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media (min-width: 768px) { 
    .section-padding-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .heading-{{ section.id }} { 
    font-size: {{ size_heading | times: 0.6 }}rem; 
  }
  .gap-mobile-{{ section.id }} {
    gap: {{ section.settings.spacing_mobile }}px;
  }
  #shopify-section-{{ section.id }}{
    background: {{ section.settings.background_color_light }};
  }
  .content--{{ section.id }} {
    {% if section.settings.text_light.alpha != 0.0 %}
      --colors-text: {{ section.settings.text_light.red }},{{ section.settings.text_light.green }},{{ section.settings.text_light.blue }};
    {% endif %}
    {% if section.settings.title_color.alpha != 0.0 %}
      --colors-heading: {{ section.settings.title_color.red }},{{ section.settings.title_color.green }},{{ section.settings.title_color.blue }};
    {% endif %}
  }
  .dark .content--{{ section.id }} {
    {% if section.settings.title_color_dark.alpha != 0.0 %}
      --colors-heading: {{ section.settings.title_color_dark.red }},{{ section.settings.title_color_dark.green }},{{ section.settings.title_color_dark.blue }};
    {% else %}        
      --colors-heading: {{ settings.colors_dark_heading.red }}, {{ settings.colors_dark_heading.green }}, {{ settings.colors_dark_heading.blue }};
    {% endif %}
    {% if section.settings.text_dark.alpha != 0.0 %}
      --colors-text: {{ section.settings.text_dark.red }},{{ section.settings.text_dark.green }},{{ section.settings.text_dark.blue }};
    {% else %}        
      --colors-text: {{ settings.colors_dark_text.red }}, {{ settings.colors_dark_text.green }}, {{ settings.colors_dark_text.blue }};
    {% endif %}
  }
  .dark #shopify-section-{{ section.id }}{
    {% if section.settings.background_color_dark == blank %}
      background: transparent;
    {% else %}
      background: {{ section.settings.background_color_dark }};
    {% endif %}
  }
  @media screen and (min-width: 768px) {
    .gap-{{ section.id }} {
      {% if enable_desktop_slider %}
        gap: 0px;
      {% else %}
        gap: {{ section.settings.spacing }}px;
      {% endif %}
    }
    .heading-{{ section.id }}{ font-size: {{ size_heading }}rem; } 
  }
  {% if enable_desktop_slider %}
    @media (min-width: 1024px){
      .preload-slide--{{ section.id }} {
        {{ class_rtl }}: {{ section.settings.spacing }}px;
        width: calc(((100% + {{ section.settings.spacing }}px) / {{ columns_desktop }}) - {{ section.settings.spacing }}px);
      }
    }
  {% endif %}
  {% if swiper_on_mobile %}
    @media (max-width: 1023px) {
      .preload-slide--{{ section.id }} {
        {{ class_rtl }}: {{ section.settings.spacing_mobile }}px;
        width: calc(((100% + {{ section.settings.spacing_mobile }}px) / 2) - {{ section.settings.spacing_mobile }}px);
      }
    }
    @media (max-width: 767px) {
      .preload-slide--{{ section.id }} {
        {{ class_rtl }}: {{ section.settings.spacing_mobile }}px;
        width: calc(((100% + {{ section.settings.spacing_mobile }}px) / {{ columns_mobile }}) - {{ section.settings.spacing_mobile }}px);
      }
    }
  {% endif %}
{%- endstyle -%}

{%- if section.settings.show_section_divider or section.settings.show_section_divider_mobile -%}
  {% render 'section-divider' %}
{%- endif -%}

<div
  class="x-container-collection-list section-padding-{{ section.id }}{% if has_text_content %} tsv-collection-list-section tsv-collection-list-section--stack-{{ section.settings.stack_breakpoint }}{% endif %}"
  {% if has_text_content %}
    style="
      --tsv-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
      --tsv-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
      --tsv-padding-inline-start-desktop: {{ section.settings.padding_inline_start_desktop }}px;
      --tsv-padding-inline-end-desktop: {{ section.settings.padding_inline_end_desktop }}px;
      --tsv-padding-block-mobile: {{ section.settings.padding_block_mobile }}px;
      --tsv-padding-inline-mobile: {{ section.settings.padding_inline_mobile }}px;
    "
  {% endif %}
>
  {%- unless section.settings.heading == blank -%}
    <div class="x-block-header text-center mb-5 pr-5 pl-5
      {%- unless section.settings.heading_alignment contains 'center' %} flex items-center justify-between{% endunless -%}
      {%- if section.settings.heading_alignment == 'center' %} heading-center
        {%- elsif is_rtl %}{% if section.settings.heading_alignment == 'left' %} heading-right{% else %} heading-left{% endif -%}
        {%- else %} heading-{{ section.settings.heading_alignment }}{% endif -%}
      {%- unless section.settings.full_width %} x-pgw page-width{% endunless %}"
    >
      {% render 'heading-highlight',
        headingId: section.id,
        heading: section.settings.heading,
        highlight_type: section.settings.highlight_type,
        class: 'h2 block leading-tight p-break-words',
        heading_tag: section.settings.heading_tag,
        animation_heading: true
      %}
      {%- if section.settings.show_view_all -%}
        <div class="flex justify-center pt-0.5 pb-0.5 md:pb-2.5 md:pt-2.5">
          <a 
            id="ViewAll-{{ section.id }}" 
            class="nav-link effect-inline relative flex items-center hover-text-link empty:hidden cursor-pointer" 
            href="{{ routes.collections_url }}" 
            aria-labelledby="ViewAll-{{ section.id }} SectionHeading-{{ section.id }}"
          >
            {{ 'sections.collection_list.view_all' | t }}<span class="w-2 h-2 inline-block ml-1.5 mt-0.5">{% render 'icon-alls' , icon: 'icon-double-arrow' %}</span>
          </a>
        </div>
      {%- endif -%}
    </div>
  {%- endunless -%}
  {%- if has_text_content -%}
    <div
      class="tsv-collection-list__layout tsv-collection-list__layout--stack-{{ section.settings.stack_breakpoint }}"
      data-layout="{{ section.settings.layout_direction }}"
      style="
        --tsv-column-gap: {{ section.settings.column_gap }}px;
        --tsv-stack-gap: {{ section.settings.stack_gap }}px;
        --tsv-text-column-width: {{ section.settings.text_column_width }}px;
        --tsv-card-gap: {{ section.settings.card_gap }}px;
        --tsv-card-aspect-ratio: {{ section.settings.card_aspect_ratio }};
        --tsv-cards-per-row-desktop: {{ columns_desktop }};
        --tsv-cards-per-row-mobile: {{ section.settings.cards_per_row_mobile }};
        --tsv-text-padding-inline-mobile: {{ section.settings.text_padding_inline_mobile }}px;
        --tsv-card-title-size-desktop: {{ card_title_size_desktop }}px;
        --tsv-card-title-size-mobile: {{ card_title_size_mobile }}px;
        --tsv-card-title-weight: {{ section.settings.card_title_weight }};
        --tsv-card-title-letter-spacing: {{ section.settings.card_title_letter_spacing | times: 0.01 }}em;
        --tsv-card-title-color: {{ section.settings.title_color }};
        --tsv-card-title-transform: {% if section.settings.card_title_uppercase %}uppercase{% else %}none{% endif %};
        --tsv-card-title-bottom-desktop: {{ section.settings.card_title_bottom_desktop }}px;
        --tsv-card-title-bottom-mobile: {{ section.settings.card_title_bottom_mobile }}px;
      "
    >
      <div
        class="tsv-collection-list__text"
        style="
          --tsv-text-align: {{ text_content_block.settings.text_align }};
          --tsv-text-align-items: {{ text_align_items }};
          --tsv-heading-size-desktop: {{ text_content_block.settings.heading_size_desktop }}px;
          --tsv-heading-size-mobile: {{ text_content_block.settings.heading_size_mobile }}px;
          --tsv-heading-weight: {{ text_content_block.settings.heading_weight }};
          --tsv-heading-letter-spacing: {{ text_content_block.settings.heading_letter_spacing | times: 0.01 }}em;
          --tsv-heading-color: {{ text_content_block.settings.heading_color }};
          --tsv-heading-transform: {% if text_content_block.settings.heading_uppercase %}uppercase{% else %}none{% endif %};
          --tsv-heading-margin-bottom: {{ text_content_block.settings.heading_margin_bottom }}px;
          --tsv-subtitle-size-desktop: {{ text_content_block.settings.subtitle_size_desktop }}px;
          --tsv-subtitle-size-mobile: {{ text_content_block.settings.subtitle_size_mobile }}px;
          --tsv-subtitle-line-height: {{ text_content_block.settings.subtitle_line_height | times: 0.01 }};
          --tsv-subtitle-color: {{ text_content_block.settings.subtitle_color }};
          --tsv-subtitle-max-width: {{ text_content_block.settings.subtitle_max_width }}px;
          --tsv-subtitle-margin-bottom: {{ text_content_block.settings.subtitle_margin_bottom }}px;
        "
        {{ text_content_block.shopify_attributes }}
      >
        {%- if text_content_block.settings.heading != blank -%}
          <{{ text_heading_tag }} class="tsv-collection-list__heading">
            {{- text_content_block.settings.heading | escape -}}
          </{{ text_heading_tag }}>
        {%- endif -%}
        {%- if text_content_block.settings.subtitle != blank -%}
          <div class="tsv-collection-list__subtitle rte">
            {{- text_content_block.settings.subtitle -}}
          </div>
        {%- endif -%}
        {%- if text_content_block.settings.button_label != blank -%}
          {%- capture text_button_classes -%}
            tsv-collection-list__button{% if text_content_block.settings.enable_button_shine %} tsv-collection-list__button--shine{% endif %}
          {%- endcapture -%}
          {%- capture text_button_style -%}
            --tsv-button-bg: {{ text_content_block.settings.button_bg }};
            --tsv-button-bg-hover: {{ text_content_block.settings.button_bg_hover }};
            --tsv-button-text-color: {{ text_content_block.settings.button_text_color }};
            --tsv-button-font-size: {{ text_content_block.settings.button_font_size }}px;
            --tsv-button-letter-spacing: {{ text_content_block.settings.button_letter_spacing | times: 0.01 }}em;
            --tsv-button-padding-block: {{ text_content_block.settings.button_padding_block }}px;
            --tsv-button-padding-inline: {{ text_content_block.settings.button_padding_inline }}px;
            --tsv-button-radius: {{ text_content_block.settings.button_radius }}px;
            --tsv-button-transform: {% if text_content_block.settings.button_uppercase %}uppercase{% else %}none{% endif %};
            --tsv-button-focus-color: {{ text_content_block.settings.heading_color }};
            --tsv-shine-duration: {{ text_content_block.settings.shine_duration_s }}s;
            --tsv-shine-color: {{ text_content_block.settings.shine_color.red }} {{ text_content_block.settings.shine_color.green }} {{ text_content_block.settings.shine_color.blue }};
            --tsv-shine-opacity: {{ text_content_block.settings.shine_opacity | times: 0.01 }};
            --tsv-shine-width: {{ text_content_block.settings.shine_width }}%;
            --tsv-shine-angle: {{ text_content_block.settings.shine_angle }}deg;
          {%- endcapture -%}
          {%- if text_content_block.settings.button_link != blank -%}
            <a
              class="{{ text_button_classes | strip }}"
              href="{{ text_content_block.settings.button_link }}"
              style="{{ text_button_style | strip }}"
            >
              <span>{{ text_content_block.settings.button_label | escape }}</span>
            </a>
          {%- else -%}
            <span
              class="{{ text_button_classes | strip }}"
              style="{{ text_button_style | strip }}"
            >
              <span>{{ text_content_block.settings.button_label | escape }}</span>
            </span>
          {%- endif -%}
        {%- endif -%}
      </div>
  {%- endif -%}
  {%- if has_text_content == false or collection_card_count > 0 -%}
    <div class="x-block-list mr-auto ml-auto{% if swiper_on_mobile %} pl-5 pr-5 carousel-mobile carousel-tablet{% endif %}{% if section.settings.full_width %} full-width{% else %} x-pgw page-width{% endif %}{% if has_text_content %} tsv-collection-list__cards-row{% if section.settings.show_text_overlay %} tsv-collection-list__cards-row--overlay tsv-collection-list__cards-row--position-{{ section.settings.content_position }}{% endif %}{% endif %}">
    <div class="lg:pl-0 lg:pr-0">
      <div
        id="x-collection-{{ section.id }}"
        {% if enable_desktop_slider or swiper_on_mobile -%}
        class="overflow-hidden x-splide splide visible{% if is_rtl and section.settings.transition_style == "fade" %} ltr{% endif %}"
        x-intersect.once.margin.200px='$store.xSplide.load($el, {    
          "speed": 1000, 
          "pagination": false, 
          "mediaQuery": "min", 
          "updateOnMove": "true",
          "progressBar": {{ collection_card_count }},
          {% if arrow_swipe_mobile -%}
            "drag": false,
          {%- endif %}
          {% if is_rtl -%} 
            "direction": "rtl",
          {%- endif %}
          "breakpoints": {
            300: {
              {% if swiper_on_mobile == false -%} 
                "destroy": true,
              {%- endif %}
              "gap": "{{ section.settings.spacing_mobile }}px",
              "focus": "right",
              "perPage": {{ columns_mobile }},
              "perMove": {{ columns_mobile }}
            },
            768: {
              "gap": "{{ section.settings.spacing }}px",
              "perPage": 2,
              "perMove": 2
            },
            1024: {
              {% if enable_desktop_slider == false -%} 
                "destroy": true,
              {% else -%}
                "destroy": false,
              {%- endif %}
              "perPage": {{ columns_desktop }},
              "perMove": {{ columns_desktop }},
              "drag": true
            }
          },
          "classes": {
            "arrows" : "block",
            "pagination": "hidden"
          }
        })'{%- endif -%}
        x-intersect.once='$el.classList.add("is-ready-to-animate")'
      >
        <div class="splide__track lg:pt-0.5 lg:pb-0.5{% if enable_desktop_slider %} md:cursor-grab{% endif %}">
          <div class="gap-{{ section.id }} splide__list
            {%- if enable_desktop_slider == false %} lg:grid lg:grid-cols-{{ columns_desktop }}{% else %} lg:flex lg:w-full lg:gap-0{% endif -%}
            {%- if swiper_on_mobile %} flex w-full
            {%- else %} grid grid-cols-{{ columns_mobile }} md:grid md:grid-cols-4 gap-mobile-{{ section.id }}
              {%- if enable_desktop_slider %} lg:grid-cols-none{% endif -%}
            {%- endif -%}"
          >
            {%- assign card_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'text_content' -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign card_index = card_index | plus: 1 -%}
              {% style %}
                .x-slide-animation-duration-{{ card_index }} {
                  --delay-time: {{ card_index | minus: 1 | times: 100 | append: 'ms' }}
                }
              {% endstyle %}
              <div x-slide-index="{{ card_index | minus: 1 }}" id="Slide-{{ section.id }}-{{ card_index }}" class="{% unless settings.disable_carousel_animation %}x-slide-animation x-slide-animation-duration-{{ card_index }}{% endunless %}{% if swiper_on_mobile or enable_desktop_slider %} splide__slide x-splide-slide preload-slide--{{ section.id }}{% endif %}" {{ block.shopify_attributes }}>
                {% case block.type %}
                  {%- when 'featured_collection' -%}
                    {% render 'card-collection',
                      card_collection: block.settings.collection,
                      image_ratio: section.settings.image_ratio,
                      ratio: ratio,
                      columns_desktop: columns_desktop,
                      columns_mobile: columns_mobile,
                      block_type: block.type,
                      block: block,
                      enable_desktop_slider: enable_desktop_slider,
                      text_overlay: section.settings.show_text_overlay,
                      title_size: section.settings.title_size,
                      content_alignment: section.settings.content_alignment,
                      content_position: section.settings.content_position,
                      image_overlay_opacity: section.settings.image_overlay_opacity,
                      collection_metafield: section.settings.collection_metafield,
                      show_item_count: section.settings.show_item_count,
                      custom_collection_title: block.settings.title,
                      desktop_spacing: section.settings.spacing,
                      mobile_spacing: section.settings.spacing_mobile,
                      full_width: section.settings.full_width
                    %}
                  {%- when 'promotion_block' -%}
                    {% render 'promotion-block',
                      blockID: block.id,
                      ratio: 100,
                      image_extend_height: true,
                      image: block.settings.image,
                      button_label: block.settings.button_label,
                      button_link: block.settings.button_link,
                      alignment: block.settings.alignment,
                      content_position: block.settings.content_position,
                      heading: block.settings.heading,
                      content: block.settings.content,
                      columns_desktop: columns_desktop,
                      columns_mobile: columns_mobile,
                      block: block,
                      enable_desktop_slider: enable_desktop_slider,
                      open_new_window : block.settings.open_new_window,
                      image_overlay_opacity: block.settings.image_overlay_opacity,
                      title_size: block.settings.title_size,
                      text_size: block.settings.text_size,
                      show_button_style: block.settings.show_button_style,
                      color_button: block.settings.color_button,
                      color_text_button: block.settings.color_text_button,
                      color_button_hover: block.settings.color_button_hover,
                      color_text_button_hover: block.settings.color_text_button_hover,
                      color_button_secondary: block.settings.color_button_secondary,
                      secondary_button_text: block.settings.secondary_button_text,
                      icon: block.settings.icon,
                      another_icon: block.settings.another_icon,
                      custom_icon: block.settings.custom_icon,
                      icon_size: block.settings.icon_size,
                      subheading: block.settings.subheading,
                      image_link: block.settings.image_link,
                      open_new_window_image: block.settings.open_new_window_image,
                      heading_highlight: true,
                      color_heading_highlight_dark: block.settings.color_heading_highlight_dark,
                      color_heading_highlight_light: block.settings.color_heading_highlight_light,
                      highlight_type: block.settings.highlight_type
                      colors_text_link: block.settings.colors_text_link
                    %}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
        {%- if swiper_on_mobile or enable_desktop_slider -%}
          <div class="splide__arrows{% if swiper_on_mobile %} flex items-center justify-center gap-3 md:gap-0 mb-1 lg:mb-0 mt-5 lg:mt-0{% endif %}">
            <button 
              class="splide__arrow splide__arrow--prev button-arrow pt-3 pb-3 pr-3 pl-3 rounded-full none_border z-10 w-11 h-11 border border-solid lg:border-none after:text-[20px] rtl:rotate-180 disabled:cursor-not-allowed disabled:opacity-30
              {%- unless arrow_swipe_mobile %} hidden{% else %} block{% endunless -%}
              {%- if enable_desktop_slider %} lg:-mt-6 lg:block lg:absolute lg:top-1/2 lg:left-0 rtl:lg:left-auto rtl:lg:right-0 lg:transition-all lg:ease-in-out lg:-translate-x-full rtl:lg:translate-x-full lg:duration-200 hover:opacity-100{% else %} lg:hidden{% endif -%}"
              aria-label="previous slide"
            >
              <span class="hidden">previous slide</span>
              {% render 'icon-labels-bags', icon: 'chevron-left' %}
            </button>
            <button 
              class="splide__arrow splide__arrow--next button-arrow pt-3 pb-3 pr-3 pl-3 rounded-full none_border z-10 w-11 h-11 border border-solid lg:border-none after:text-[20px] rtl:rotate-180 disabled:cursor-not-allowed disabled:opacity-30
              {%- unless arrow_swipe_mobile %} hidden{% else %} block{% endunless -%}
              {%- if enable_desktop_slider %} lg:-mt-6 lg:block lg:absolute lg:top-1/2 lg:right-0 rtl:lg:right-auto rtl:lg:left-0 lg:transition-all lg:ease-in-out lg:translate-x-full rtl:lg:-translate-x-full lg:duration-200 hover:opacity-100{% else %} lg:hidden{% endif -%}"
              aria-label="next slide"
            >
              <span class="hidden">next slide</span>
              {% render 'icon-labels-bags', icon: 'chevron-right' %}
            </button>
          </div>
        {%- endif -%}
        {%- if swiper_on_mobile or enable_desktop_slider -%}
          <div class="x-pgw page-width{% if enable_desktop_slider %} lg:flex{% else %} lg:hidden{% endif %}{% if arrow_swipe_mobile or swiper_on_mobile == false %} hidden{% else %} flex{% endif %} items-center gap-5 mt-2.5 w-full ml-auto mr-auto">
            <div class="splide-progress inline-block grow rounded-md">
              {% liquid
                assign my_float = columns_desktop | times: 100.0
                assign width_bar = my_float | divided_by: collection_card_count
                assign mobile_float = columns_mobile | times: 100.0
                assign mobile_width_bar = mobile_float | divided_by: collection_card_count
              %} 
              {%- style -%}
                .splide-progress-bar-{{ section.id }} {
                  width: {{ mobile_width_bar }}%;
                }
                @media (min-width: 768px) {
                  .splide-progress-bar-{{ section.id }} {
                    width: {{ width_bar }}%;
                  }
                }
              {%- endstyle -%}
              <div class="splide-progress-bar-{{ section.id }} splide-progress-bar rounded-md"></div>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
    </div>
  {%- endif -%}
  {%- if has_text_content -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.collection-list.name",
  "tag": "section",
  "class": "section section-collection-list x-section",
  "max_blocks": 16,
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.user_guide_link.section_and_blocks.collection_list"
    },
    {
      "type": "header",
      "content": "Best Sellers layout"
    },
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Text position",
      "options": [
        {
          "value": "text_left",
          "label": "Left"
