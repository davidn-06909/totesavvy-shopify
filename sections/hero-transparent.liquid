{%- liquid
  case section.settings.height_desktop
    when 'svh85'
      assign hero_height_desktop = '85svh'
    when 'svh70'
      assign hero_height_desktop = '70svh'
    when 'fixed'
      assign hero_height_desktop = section.settings.height_desktop_fixed | append: 'px'
    else
      assign hero_height_desktop = '100svh'
  endcase

  case section.settings.height_mobile
    when 'svh85'
      assign hero_height_mobile = '85svh'
    when 'svh70'
      assign hero_height_mobile = '70svh'
    when 'fixed'
      assign hero_height_mobile = section.settings.height_mobile_fixed | append: 'px'
    else
      assign hero_height_mobile = '100svh'
  endcase

  assign scrim_desktop = 'none'
  unless section.settings.scrim_direction == 'none'
    assign scrim_desktop_alpha = section.settings.scrim_opacity | divided_by: 100.0
    capture scrim_desktop
      echo 'linear-gradient('
      echo section.settings.scrim_direction
      echo ', rgb(0 0 0 / '
      echo scrim_desktop_alpha
      echo ') 0%, transparent 55%)'
    endcapture
  endunless

  assign scrim_mobile = 'none'
  unless section.settings.scrim_direction_mobile == 'none'
    assign scrim_mobile_alpha = section.settings.scrim_opacity_mobile | divided_by: 100.0
    capture scrim_mobile
      echo 'linear-gradient('
      echo section.settings.scrim_direction_mobile
      echo ', rgb(0 0 0 / '
      echo scrim_mobile_alpha
      echo ') 0%, transparent 60%)'
    endcapture
  endunless

  assign button_1_url = section.settings.button_1_url | default: '/collections/all'
  assign button_2_url = section.settings.button_2_url | default: '/collections/all'
  assign show_actions = false
  if section.settings.button_1_label != blank or section.settings.button_2_label != blank
    assign show_actions = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --tsh-hero-height-desktop: {{ hero_height_desktop }};
    --tsh-hero-height-mobile: {{ hero_height_mobile }};
    --tsh-hero-image-position: {{ section.settings.image_position }};
    --tsh-hero-title-size: {{ section.settings.title_size_desktop }}px;
    --tsh-hero-title-size-tablet: {{ section.settings.title_size_tablet }}px;
    --tsh-hero-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --tsh-hero-title-line-height: {{ section.settings.title_line_height | divided_by: 100.0 }};
    --tsh-hero-title-letter-spacing: {{ section.settings.title_letter_spacing | divided_by: 100.0 }}em;
    --tsh-hero-title-color: {{ section.settings.title_color }};
    --tsh-hero-title-max-width: {{ section.settings.title_max_width }}px;
    --tsh-hero-subtitle-size: {{ section.settings.subtitle_size_desktop }}px;
    --tsh-hero-subtitle-size-mobile: {{ section.settings.subtitle_size_mobile }}px;
    --tsh-hero-subtitle-color: {{ section.settings.subtitle_color }};
    --tsh-hero-title-gap: {{ section.settings.gap_title_subtitle }}px;
    --tsh-hero-actions-gap-top: {{ section.settings.gap_subtitle_actions }}px;
    --tsh-hero-button-gap: {{ section.settings.button_gap }}px;
    --tsh-hero-button-height: {{ section.settings.button_height }}px;
    --tsh-hero-button-height-mobile: {{ section.settings.button_height_mobile }}px;
    --tsh-hero-button-padding: {{ section.settings.button_padding_inline }}px;
    --tsh-hero-button-padding-mobile: {{ section.settings.button_padding_inline_mobile }}px;
    --tsh-hero-button-font-size: {{ section.settings.button_font_size }}px;
    --tsh-hero-button-font-size-mobile: {{ section.settings.button_font_size_mobile }}px;
    --tsh-hero-button-letter-spacing: {{ section.settings.button_letter_spacing | divided_by: 100.0 }}em;
    --tsh-hero-button-radius: {{ section.settings.button_radius }}px;
    --tsh-hero-button-1-bg: {{ section.settings.button_1_bg }};
    --tsh-hero-button-1-bg-hover: {{ section.settings.button_1_bg_hover }};
    --tsh-hero-button-1-text: {{ section.settings.button_1_text_color }};
    --tsh-hero-content-offset: {{ section.settings.content_offset_inline }}px;
    --tsh-hero-content-offset-mobile: {{ section.settings.content_offset_inline_mobile }}px;
    --tsh-hero-content-block-mobile: {{ section.settings.content_offset_block_mobile }}px;
    --tsh-hero-content-max-width: {{ section.settings.content_max_width }}px;
    --tsh-hero-scrim-desktop: {{ scrim_desktop | strip }};
    --tsh-hero-scrim-mobile: {{ scrim_mobile | strip }};
  }
{%- endstyle -%}

<section
  class="tsh-hero"
  data-align-desktop="{{ section.settings.content_align_desktop }}"
  data-valign-desktop="{{ section.settings.content_valign_desktop }}"
  data-align-mobile="{{ section.settings.content_align_mobile }}"
  data-valign-mobile="{{ section.settings.content_valign_mobile }}"
>
  <div class="tsh-hero__media">
    {%- if section.settings.image != blank -%}
      {%- assign image_alt = section.settings.image.alt | default: section.settings.title | escape -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          widths: '375, 550, 750, 1100, 1500, 2000, 2600, 3200, 3840',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          class: 'tsh-hero__image',
          alt: image_alt
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'tsh-hero__placeholder' }}
    {%- endif -%}
  </div>
  <div class="tsh-hero__scrim" aria-hidden="true"></div>

  <div class="tsh-hero__content">
    {%- if section.settings.title != blank -%}
      <h1 class="tsh-hero__title{% if section.settings.title_uppercase %} tsh-hero__title--uppercase{% endif %}">
        {{ section.settings.title | escape }}
      </h1>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="tsh-hero__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}

    {%- if show_actions -%}
      <div class="tsh-hero__actions">
        {%- if section.settings.button_1_label != blank -%}
          <a class="tsh-hero__button tsh-hero__button--primary" href="{{ button_1_url }}">
            {{ section.settings.button_1_label | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a
            class="tsh-hero__button tsh-hero__button--secondary"
            href="{{ button_2_url }}"
            style="--tsh-hero-button-2-bg: {{ section.settings.button_2_bg }};"
          >
            {{ section.settings.button_2_label | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

