{%- liquid
  assign block_count = section.blocks.size
  assign repeat_count = 1
  assign maximum_viewport_height = section.settings.viewport_height_desktop

  if section.settings.viewport_height_mobile > maximum_viewport_height
    assign maximum_viewport_height = section.settings.viewport_height_mobile
  endif

  if block_count > 0
    assign minimum_items_per_group = maximum_viewport_height | times: 1.0 | divided_by: section.settings.card_min_height | ceil | plus: 1
    assign repeat_count = minimum_items_per_group | times: 1.0 | divided_by: block_count | ceil
  endif

  assign visual_items_per_group = block_count | times: repeat_count
  assign animation_duration = section.settings.seconds_per_item | times: visual_items_per_group
  assign half_card_gap = section.settings.card_gap | divided_by: 2.0
  assign heading_line_height = section.settings.heading_line_height | times: 0.01
  assign subtitle_line_height = section.settings.subtitle_line_height | times: 0.01
  assign review_title_line_height = section.settings.review_title_line_height | times: 0.01
  assign review_body_line_height = section.settings.review_body_line_height | times: 0.01
  assign heading_letter_spacing = section.settings.heading_letter_spacing | times: 0.01
-%}

{%- style -%}
  #Testimonials-{{ section.id }} {
    --tsv-testimonials-intro-width: {{ section.settings.intro_width }}%;
    --tsv-testimonials-column-gap: {{ section.settings.column_gap }}px;
    --tsv-testimonials-mobile-stack-gap: {{ section.settings.mobile_stack_gap }}px;
    --tsv-testimonials-reviews-max-width: {{ section.settings.reviews_max_width }}px;
    --tsv-testimonials-viewport-height: {{ section.settings.viewport_height_desktop }}px;
    --tsv-testimonials-viewport-height-mobile: {{ section.settings.viewport_height_mobile }}px;
    --tsv-testimonials-card-min-height: {{ section.settings.card_min_height }}px;
    --tsv-testimonials-card-gap: {{ section.settings.card_gap }}px;
    --tsv-testimonials-half-card-gap: {{ half_card_gap }}px;
    --tsv-testimonials-animation-duration: {{ animation_duration }}s;

    --tsv-testimonials-margin-top: {{ section.settings.margin_top }}px;
    --tsv-testimonials-margin-bottom: {{ section.settings.margin_bottom }}px;
    --tsv-testimonials-margin-top-mobile: {{ section.settings.margin_top_mobile }}px;
    --tsv-testimonials-margin-bottom-mobile: {{ section.settings.margin_bottom_mobile }}px;
    --tsv-testimonials-padding-top: {{ section.settings.top_padding }}px;
    --tsv-testimonials-padding-bottom: {{ section.settings.bottom_padding }}px;
    --tsv-testimonials-padding-top-mobile: {{ section.settings.top_padding_mobile }}px;
    --tsv-testimonials-padding-bottom-mobile: {{ section.settings.bottom_padding_mobile }}px;
    --tsv-testimonials-card-padding: {{ section.settings.card_padding }}px;
    --tsv-testimonials-card-padding-mobile: {{ section.settings.card_padding_mobile }}px;
    --tsv-testimonials-heading-subtitle-gap: {{ section.settings.heading_subtitle_gap }}px;
    --tsv-testimonials-review-title-body-gap: {{ section.settings.review_title_body_gap }}px;
    --tsv-testimonials-body-metadata-gap: {{ section.settings.body_metadata_gap }}px;

    --tsv-testimonials-border-width: {{ section.settings.card_border_width }}px;
    --tsv-testimonials-border-radius: {{ section.settings.card_border_radius }}px;

    --tsv-testimonials-heading-size: {{ section.settings.heading_size_desktop }}px;
    --tsv-testimonials-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --tsv-testimonials-heading-weight: {{ section.settings.heading_weight }};
    --tsv-testimonials-heading-line-height: {{ heading_line_height }};
    --tsv-testimonials-heading-letter-spacing: {{ heading_letter_spacing }}em;
    --tsv-testimonials-subtitle-size: {{ section.settings.subtitle_size_desktop }}px;
    --tsv-testimonials-subtitle-size-mobile: {{ section.settings.subtitle_size_mobile }}px;
    --tsv-testimonials-subtitle-weight: {{ section.settings.subtitle_weight }};
    --tsv-testimonials-subtitle-line-height: {{ subtitle_line_height }};
    --tsv-testimonials-review-title-size: {{ section.settings.review_title_size_desktop }}px;
    --tsv-testimonials-review-title-size-mobile: {{ section.settings.review_title_size_mobile }}px;
    --tsv-testimonials-review-title-weight: {{ section.settings.review_title_weight }};
    --tsv-testimonials-review-title-line-height: {{ review_title_line_height }};
    --tsv-testimonials-review-title-transform: {% if section.settings.review_title_uppercase %}uppercase{% else %}none{% endif %};
    --tsv-testimonials-review-body-size: {{ section.settings.review_body_size_desktop }}px;
    --tsv-testimonials-review-body-size-mobile: {{ section.settings.review_body_size_mobile }}px;
    --tsv-testimonials-review-body-weight: {{ section.settings.review_body_weight }};
    --tsv-testimonials-review-body-line-height: {{ review_body_line_height }};
    --tsv-testimonials-metadata-size: {{ section.settings.metadata_size }}px;
    --tsv-testimonials-author-weight: {{ section.settings.author_weight }};
    --tsv-testimonials-metadata-weight: {{ section.settings.metadata_weight }};

    --tsv-testimonials-background-light: {{ section.settings.background_color_light }};
    --tsv-testimonials-card-background-light: {% if section.settings.item_background_color_light.alpha == 0.0 %}rgb(var(--colors-background-secondary)){% else %}{{ section.settings.item_background_color_light }}{% endif %};
    --tsv-testimonials-border-color-light: {% if section.settings.item_border_color_light.alpha == 0.0 %}rgb(var(--colors-line-and-border)){% else %}{{ section.settings.item_border_color_light }}{% endif %};
    --tsv-testimonials-heading-color-light: {% if section.settings.heading_and_title_light.alpha == 0.0 %}rgb(var(--colors-heading)){% else %}{{ section.settings.heading_and_title_light }}{% endif %};
    --tsv-testimonials-text-color-light: {% if section.settings.item_text_color_light.alpha == 0.0 %}rgb(var(--colors-text)){% else %}{{ section.settings.item_text_color_light }}{% endif %};
    --tsv-testimonials-verified-color-light: {{ section.settings.verified_color_light }};

    --tsv-testimonials-background-dark: {{ section.settings.background_color_dark }};
    --tsv-testimonials-card-background-dark: {% if section.settings.item_background_color_dark.alpha == 0.0 %}rgb(var(--colors-background-secondary)){% else %}{{ section.settings.item_background_color_dark }}{% endif %};
    --tsv-testimonials-border-color-dark: {% if section.settings.item_border_color_dark.alpha == 0.0 %}rgb(var(--colors-line-and-border)){% else %}{{ section.settings.item_border_color_dark }}{% endif %};
    --tsv-testimonials-heading-color-dark: {% if section.settings.heading_and_title_dark.alpha == 0.0 %}rgb(var(--colors-heading)){% else %}{{ section.settings.heading_and_title_dark }}{% endif %};
    --tsv-testimonials-text-color-dark: {% if section.settings.item_text_color_dark.alpha == 0.0 %}rgb(var(--colors-text)){% else %}{{ section.settings.item_text_color_dark }}{% endif %};
    --tsv-testimonials-verified-color-dark: {{ section.settings.verified_color_dark }};
  }
{%- endstyle -%}

{%- if section.settings.show_section_divider or section.settings.show_section_divider_mobile -%}
  {% render 'section-divider' %}
{%- endif -%}

<section
  id="Testimonials-{{ section.id }}"
  class="tsv-testimonials"
  aria-label="{{ section.settings.heading | default: 'Customer reviews' | escape }}"
>
  <div class="tsv-testimonials__inner{% if section.settings.heading == blank and section.settings.subheading == blank %} tsv-testimonials__inner--reviews-only{% endif %} x-pgw page-width">
    <div class="tsv-testimonials__intro">
      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_tag }}
          id="TestimonialsHeading-{{ section.id }}"
          class="tsv-testimonials__heading"
        >
          {{- section.settings.heading | escape -}}
        </{{ section.settings.heading_tag }}>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="tsv-testimonials__subtitle">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    {%- if block_count > 0 -%}
      <div class="tsv-testimonials__reviews">
        <div
          class="tsv-testimonials__marquee"
          tabindex="0"
          aria-live="off"
          {% if section.settings.heading != blank %}
            aria-labelledby="TestimonialsHeading-{{ section.id }}"
          {% else %}
            aria-label="Customer reviews"
          {% endif %}
        >
          <div class="tsv-testimonials__track">
            <ul class="tsv-testimonials__group" role="list">
              {%- for repetition in (1..repeat_count) -%}
                {%- for block in section.blocks -%}
                  {%- if repetition == 1 -%}
                    {% render 'testimonial-review-card',
                      block: block,
                      section: section,
                      is_duplicate: false
                    %}
                  {%- else -%}
                    {% render 'testimonial-review-card',
                      block: block,
                      section: section,
                      is_duplicate: true
                    %}
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
            </ul>

            <ul class="tsv-testimonials__group tsv-testimonials__group--duplicate" role="list" aria-hidden="true">
              {%- for repetition in (1..repeat_count) -%}
                {%- for block in section.blocks -%}
                  {% render 'testimonial-review-card',
                    block: block,
                    section: section,
                    is_duplicate: true
                  %}
                {%- endfor -%}
              {%- endfor -%}
            </ul>
          </div>
        </div>
      </div>
    {%- elsif request.design_mode -%}
      <div class="tsv-testimonials__empty">
        Add review blocks to start the testimonial flow.
      </div>
    {%- endif -%}
  </div>
</section>

