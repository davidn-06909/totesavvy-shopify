{% liquid 
  if settings.lang_direction contains request.locale.iso_code
    assign class_rtl = 'rtl'
    assign is_rtl = true
  else
    assign class_rtl = 'ltr'
    assign is_rtl = false
  endif
  if settings.enable_lazy_loading_image
    assign loading = 'lazy'
  else
    assign loading = 'eager'
  endif

  assign configured_social_links = settings.social_twitter_link
  assign configured_social_links = configured_social_links | append: settings.social_facebook_link
  assign configured_social_links = configured_social_links | append: settings.social_pinterest_link
  assign configured_social_links = configured_social_links | append: settings.social_instagram_link
  assign configured_social_links = configured_social_links | append: settings.social_tiktok_link
  assign configured_social_links = configured_social_links | append: settings.social_tumblr_link
  assign configured_social_links = configured_social_links | append: settings.social_snapchat_link
  assign configured_social_links = configured_social_links | append: settings.social_youtube_link
  assign configured_social_links = configured_social_links | append: settings.social_vimeo_link
  assign configured_social_links = configured_social_links | append: settings.social_linkedin_link
  assign configured_social_links = configured_social_links | append: settings.social_line_link
  assign configured_social_links = configured_social_links | append: settings.email_address
  assign configured_social_links = configured_social_links | append: settings.phone_number
  assign has_social_links = false
  if configured_social_links != blank
    assign has_social_links = true
  endif
%}
<footer
  id="section-footer"
  class="footer-root section-footer relative sticky-footer selection:bg-[rgba(var(--colors-text-footer),0.2)]"
  style="
    --footer-background: {{ section.settings.footer_background | default: '#F0EAE4' }};
    --footer-heading-color: {{ section.settings.footer_heading_color | default: '#B08B5A' }};
    --footer-text-color: {{ section.settings.footer_text_color | default: '#2E2A26' }};
    --footer-muted-text-color: {{ section.settings.footer_muted_text_color | default: '#5A554F' }};
    --footer-border-color: {{ section.settings.footer_border_color | default: '#2E2A26' }};
    --footer-dropdown-background: {{ section.settings.dropdown_background | default: '#F0EAE4' }};
    --footer-padding-top: {{ section.settings.padding_top | default: 64 }}px;
    --footer-padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
    --footer-padding-top-mobile: {{ section.settings.padding_top_mobile | default: 48 }}px;
    --footer-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 32 }}px;
    --footer-side-padding-desktop: {{ section.settings.side_padding_desktop | default: 64 }}px;
    --footer-side-padding-tablet: {{ section.settings.side_padding_tablet | default: 40 }}px;
    --footer-side-padding-mobile: {{ section.settings.side_padding_mobile | default: 24 }}px;
    --footer-column-gap-desktop: {{ section.settings.column_gap_desktop | default: 0 }}px;
    --footer-column-row-gap: {{ section.settings.column_row_gap | default: 48 }}px;
    --footer-heading-margin-bottom: {{ section.settings.heading_margin_bottom | default: 16 }}px;
    --footer-link-row-gap: {{ section.settings.link_row_gap | default: 5 }}px;
    --footer-bottom-bar-gap: {{ section.settings.bottom_bar_gap | default: 88 }}px;
    --footer-bottom-bar-gap-mobile: {{ section.settings.bottom_bar_gap_mobile | default: 48 }}px;
    --footer-bottom-stack-gap-mobile: {{ section.settings.bottom_stack_gap_mobile | default: 32 }}px;
    --footer-copyright-gap: {{ section.settings.copyright_gap | default: 16 }}px;
    --footer-copyright-gap-mobile: {{ section.settings.copyright_gap_mobile | default: 24 }}px;
    --footer-mobile-text-align: {{ section.settings.mobile_text_align | default: 'center' }};
    --footer-mobile-flex-align: {% if section.settings.mobile_text_align == 'left' %}flex-start{% else %}center{% endif %};
    --footer-heading-font-size: {{ section.settings.heading_font_size | default: 15 }}px;
    --footer-heading-letter-spacing: {{ section.settings.heading_letter_spacing | default: 1.5 }}px;
    --footer-heading-uppercase: {% if section.settings.heading_uppercase == false %}none{% else %}uppercase{% endif %};
    --footer-link-font-size: {{ section.settings.link_font_size | default: 15 }}px;
    --footer-link-line-height: {{ section.settings.link_line_height | default: 1.4 }};
    --footer-copyright-font-size: {{ section.settings.copyright_font_size | default: 13 }}px;
    --footer-social-icon-size: {{ section.settings.social_icon_size | default: 20 }}px;
    --footer-social-icon-gap: {{ section.settings.social_icon_gap | default: 28 }}px;
    --footer-social-row-margin-top: {{ section.settings.social_row_margin_top | default: 16 }}px;
    --footer-currency-min-width: {{ section.settings.currency_min_width | default: 152 }}px;
    --footer-currency-height: {{ section.settings.currency_height | default: 41 }}px;
    --footer-currency-border-width: {{ section.settings.currency_border_width | default: 1 }}px;
    --footer-currency-border-radius: {{ section.settings.currency_border_radius | default: 4 }}px;
    --footer-currency-font-size: {{ section.settings.currency_font_size | default: 15 }}px;
    --footer-currency-padding-x: {{ section.settings.currency_padding_x | default: 12 }}px;
    --footer-dropdown-max-height: {{ section.settings.dropdown_max_height | default: 245 }}px;
    --footer-dropdown-offset: {{ section.settings.dropdown_offset | default: 6 }}px;
    --footer-dropdown-item-padding-y: {{ section.settings.dropdown_item_padding_y | default: 6 }}px;
    --footer-show-payment-icons: {% if section.settings.payment_enable %}1{% else %}0{% endif %};
    --footer-payment-icon-width: {{ section.settings.payment_icon_width | default: 55 }}px;
    --footer-payment-icon-height: {{ section.settings.payment_icon_height | default: 40 }}px;
    --footer-payment-icon-gap: {{ section.settings.payment_icon_gap | default: 6 }}px;
    --footer-payment-icon-row-gap: {{ section.settings.payment_icon_row_gap | default: 8 }}px;
    --footer-column-count: {{ section.blocks.size | at_least: 1 }};
  "
>
  <div class="footer-inner">
      {%- if section.blocks.size > 0 -%}
        <div class="footer-columns">
          {%- for block in section.blocks -%}
            <div class="footer-column footer-col--{{ forloop.index }} {{ class_rtl }}" {{ block.shopify_attributes }}>
              {%- case block.type -%}
                {%- when 'text' -%}
                  <div class="footer-main__block">
                    {%- if block.settings.heading_text != blank -%}
                      <h2 class="column-heading" id="footer-heading-{{ section.id }}-{{ block.id }}">
                        {{ block.settings.heading_text | escape }}
                      </h2>
                    {%- endif -%}
                    {%- if block.settings.image != blank -%}
                      {%- capture sizes -%}
                        {{ block.settings.image_width | times: 2 | ceil }}px
                      {%- endcapture -%}
                      {% style %}
                        .image-{{ block.id }} {
                          width: {{ block.settings.image_width }}px;
                        }
                      {% endstyle %}
                      {% assign image_tags = block.settings.image_width | times: 2 | ceil | append: '' %}
                    {%- endif -%}
                    {% capture text_block_content %}
                      {%- if block.settings.image != blank -%}
                        {%- if block.settings.link_image_footer != blank -%}
                          <a href="{{ block.settings.link_image_footer }}"{% if block.settings.open_new_window %} target="_blank"{% endif %} class="image-{{ block.id }} h-full inline-block overflow-hidden{% if block.settings.heading_text != blank %} mt-6{% endif %}{% if settings.edges_type == 'rounded_corners' %} rounded-[10px]{% endif %}">
                        {%- else -%}
                          <div class="image-{{ block.id }} h-full inline-block overflow-hidden{% if block.settings.heading_text != blank %} mt-6{% endif %}{% if settings.edges_type == 'rounded_corners' %} rounded-[10px]{% endif %}">
                        {%- endif -%}
                          {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: widths: image_tags,
                            height: block.settings.image.height,
                            class: "image-hover",
                            width: block.settings.image.width,
                            sizes: sizes,
                            loading: loading,
                            alt: block.settings.image.alt | escape
                          }}
                        {%- if block.settings.link_image_footer != blank -%}
                          </a>
                        {%- else -%}
                          </div>
                        {%- endif -%}
                      {%- endif -%}
                      {%- if block.settings.subtext != blank -%}
                        <div class="rte{% if block.settings.image != blank %} mt-2{% else %} mt-6{% endif %}">{{ block.settings.subtext }}</div>
                      {%- endif -%}
                      {%- if block.settings.show_social_icons and has_social_links -%}
                        <div class="social-row">
                          {% render 'toolbar', enable_footer: true, show_social_icons: block.settings.show_social_icons, social_icons_layout: block.settings.icon_layout %}
                        </div>
                      {%- endif -%}
                    {% endcapture %}
                    <div class="footer-main__block-content">
                      {{ text_block_content }}
                    </div>
                  </div>
                {%- when 'link_list' -%}
                  <div class="footer-main__block">
                    {%- if block.settings.heading_menu != blank -%}
                      <h2 class="column-heading" id="footer-heading-{{ section.id }}-{{ block.id }}">
                        {{- block.settings.heading_menu | escape -}}
                      </h2>
                    {%- endif -%}
                    {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
                      <ul
                        class="column-links"
                        role="list"
                        {% if block.settings.heading_menu != blank %}
                          aria-labelledby="footer-heading-{{ section.id }}-{{ block.id }}"
                        {% endif %}
                      >
                        {%- for link in block.settings.menu.links -%}
                          <li>
                            <a href="{{ link.url }}">{{ link.title }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                    {%- if block.settings.show_social_icons and has_social_links -%}
                      <div class="social-row">
                        {% render 'toolbar', enable_footer: true, show_social_icons: block.settings.show_social_icons %}
                      </div>
                    {%- endif -%}
                  </div>
                {%- when 'image' -%}
                  <div class="footer-main__block pt-4 pb-4 flex flex-col justify-start text-{{ block.settings.alignment }} rtl:text-{% if block.settings.alignment == 'center' %}center{% elsif block.settings.alignment == 'left' %}right{% else %}left{% endif -%}
                    {%- if block.settings.alignment == 'center' %} items-center{% elsif block.settings.alignment == 'right' %} items-end{% endif %}"
                  >
                    {%- if block.settings.image != blank -%}
                      {%- capture sizes -%}
                        {{ block.settings.image_width | times: 2 | ceil }}px
                      {%- endcapture -%}
                      {% style %}
                        .image-{{ block.id }} {
                          width: {{ block.settings.image_width }}px;
                        }
                      {% endstyle %}
                      {% assign image_tags = block.settings.image_width | times: 2 | ceil | append: '' %}
                      {% liquid 
                        assign class_image = 'image hover'
                        if block.settings.image_dark != blank
                          assign class_image = 'image hover dark:hidden'
                        endif
                      %}
                      {%- if block.settings.link_image_footer != blank -%}
                        <a href="{{ block.settings.link_image_footer }}"{% if block.settings.open_new_window %} target="_blank"{% endif %} class="image-{{ block.id }} h-full inline-block overflow-hidden{% if block.settings.rounded_corner_image %} rounded-[10px]{% endif %}">
                      {%- else -%}
                        <div class="image-{{ block.id }} h-full inline-block overflow-hidden{% if block.settings.rounded_corner_image %} rounded-[10px]{% endif %}">
                      {%- endif -%}
                        {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: widths: image_tags,
                          height: 'auto',
                          class: class_image,
                          width: block.settings.image_width,
                          sizes: sizes,
                          loading: loading,
                          alt: block.settings.image.alt | escape
                        }}
                        {% if block.settings.image_dark != blank %}
                          {{ block.settings.image_dark | image_url: width: block.settings.image_dark.width | image_tag: widths: image_tags,
                            height: 'auto',
                            class: "image-hover hidden dark:block",
                            width: block.settings.image_width,
                            sizes: sizes,
                            loading: loading,
                            alt: block.settings.image_dark.alt | escape
                          }}
                        {% endif %}
                      {%- if block.settings.link_image_footer != blank -%}
                        </a>
                      {%- else -%}
                        </div>
                      {%- endif -%}
                    {%- else -%}
                      {% liquid
                        assign class_img = 'max-w-[13rem] bg-neutral-200'
                        if block.settings.rounded_corner_image 
                          assign class_img = class_img | append: ' rounded-[10px]'
                        endif
                      %}
                      {{ 'image' | placeholder_svg_tag: class_img }}  
                    {%- endif -%}
                    {% if block.settings.text != blank %}
                      {% style %}
                        .text-{{ block.id }} {
                          margin-top: {{ block.settings.spacing }}px;
                        }
                        .text-{{ block.id }}.rte p:first-child {
                          margin-top: 0px;
                        }
                      {% endstyle %}
                      <div class="text-{{ block.id }} rte">{{ block.settings.text }}</div>
                    {% endif %}
                  </div>
                {%- when 'email_footer' -%}
                  <div class="footer-main__block pt-4 pb-4">
                    <h2 class="column-heading" id="footer-heading-{{ section.id }}-{{ block.id }}">
                      {{ block.settings.heading_email | escape }}
                    </h2>
                    <div class="footer-main__block-content">
                      {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form mb-5' -%}
                        <input type="hidden" aria-hidden="true" name="contact[tags]" value="newsletter">
                        <div class="mt-4 flex">
                          <div class="relative w-full">
                            <input
                              id="NewsletterForm--{{ section.id }}"
                              type="email"
                              name="contact[email]"
                              aria-label="Email"
                              class="w-full h-full pl-2.5 pr-4 pt-5 input border-b-2 border-current rounded-none border-b-solid focus:outline-none focus:border-current bg-transparent placeholder:opacity-0"
                              aria-required="true"
                              autocorrect="off"
                              autocapitalize="off"
                              autocomplete="email"
                              {% if form.errors %}
                                autofocus
                                aria-invalid="true"
                                aria-describedby="ContactFooter-error"
                              {% elsif form.posted_successfully? %}
                                aria-describedby="ContactFooter-success"
                              {% endif %}
                                placeholder="{{ 'newsletter.label' | t }}"
                                required>
                            <label class="absolute top-1/2 left-2.5 rtl:left-auto rtl:right-2.5 -translate-y-1/2 input_focus:text-xs input_focus:top-2.5 input_not_empty:top-2.5 input_not_empty:text-xs" for="NewsletterForm--{{ section.id }}">
                              {{ 'newsletter.label' | t }}
                            </label>
                          </div>
                          <div>
                            <button type="submit" class="rounded-none border-solid border-current ml-1 w-12 h-full flex justify-center items-center bg-transparent border-b-2 border-b-solid border-x-0 border-t-0" name="commit" aria-label="{{ 'newsletter.button_label' | t }}">
                              <span class="rtl:rotate-180">{% render 'icon-alls', icon: 'icon-arrow', enable_email_footer: true %}</span>
                            </button>
                          </div>
                          {%- if form.errors -%}
                            <div class="flex items-center text-left pl-4 pr-4 pt-3 pb-3 mt-4 bg-[rgba(var(--color-error),0.1)] selection:bg-[rgba(var(--color-error),0.2)]{% if settings.edges_type == 'rounded_corners' %} rounded-md{% endif %}" id="Newsletter-error--{{ section.id }}">
                              <span class="inline-block w-6 mr-2 text-[rgba(var(--color-error))]">{% render 'icon-alls', icon: 'icon-error' %} </span>
                              <p class="flex-1">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</p>
                            </div>
                          {%- endif -%}
                        </div>
                        {%- if form.posted_successfully? -%}
                          <div class="flex items-center text-left pt-3 pb-3 pl-3 pr-3 mt-4 bg-[rgba(var(--color-success),0.1)] selection:bg-[rgba(var(--color-success),0.2)] focus:shadown-none focus-visible:outline-none focus:outline-none focus-visible:shadow-none" id="Newsletter-success--{{ section.id }}" tabindex="-1" autofocus>
                            <span class="inline-block w-6 mr-2 text-[rgba(var(--color-success))]">{% render 'icon-alls', icon: 'icon-success' %}</span>
                            <p class="flex-1">{{ 'newsletter.success' | t }}</p>
                          </div>
                        {%- endif -%}
                      {%- endform -%}
                      {% if block.settings.subtext_email != blank %}
                        <div class="rte">{{ block.settings.subtext_email }}</div>
                      {% endif %}
                      {%- if block.settings.show_social_icons and has_social_links -%}
                      <div class="social-row">{% render 'toolbar', enable_footer: true, show_social_icons: block.settings.show_social_icons %}</div>
                      {%- endif -%}  
                    </div>
                  </div>
                {% when 'contact' %}
                  <div class="footer-main__block">
                    {%- if block.settings.heading_menu != blank -%}
                      <h2 class="column-heading" id="footer-heading-{{ section.id }}-{{ block.id }}">
                        {{- block.settings.heading_menu | escape -}}
                      </h2>
                    {%- endif -%}
                    {% capture contact_block_content %}
                      {% if block.settings.icon_1 != 'none' or block.settings.title_1 or block.settings.text_1 %}
                        <div class="mb-4 flex items-center gap-x-4">
                          {% if block.settings.icon_1 != 'none' %}
                            {% unless block.settings.custom_icon == blank and block.settings.another_icon_1 == blank and block.settings.icon_1 == 'another_icon' %}
                              <span class="inline-block h-6 w-6 lg:h-9 lg:w-9 min-w-[24px] lg:min-w-[36px]">
                                {% if block.settings.custom_icon == blank %}
                                  {% if block.settings.another_icon_1 != blank and block.settings.icon_1 == 'another_icon' %}
                                    {% render 'icon-new-alls', icon: block.settings.another_icon_1 %}
                                  {% else %}
                                    {% render 'icon-labels-bags', icon: block.settings.icon_1 %}
                                  {% endif %}
                                {% else %}
                                  {{ block.settings.custom_icon }}
                                {% endif %}
                              </span>
                            {% endunless %}
                          {% endif %}
                          {% if block.settings.title_1 or block.settings.text_1 %}
                            <div>
                              <p class="empty:hidden p-break-words">{{ block.settings.title_1 | escape }}</p>
                              {% if block.settings.text_link_1 != blank %}
                                <a href="{{ block.settings.text_link_1 }}"{% if block.settings.open_new_window_1 %} target="_blank"{% endif %}
                                  class="font-semibold p-break-words empty:hidden{% if block.settings.enable_text_link_1 %} text-[rgb(var(--colors-text-link))]{% endif %} hover-text-link nav-link relative"
                                >
                                  {{ block.settings.text_1 | escape }}
                                </a>
                              {% else %}
                                <p class="font-semibold p-break-words empty:hidden{% if block.settings.enable_text_link_1 %} text-[rgb(var(--colors-text-link))]{% endif %}">
                                  {{ block.settings.text_1 | escape }}
                                </p>
                              {% endif %} 
                            </div>
                          {% endif %}
                        </div>
                      {% endif %}
                      {% if block.settings.icon_2 != 'none' or block.settings.title_2 or block.settings.text_2 %}
                        <div class="mb-4 flex items-center gap-x-4">
                          {% if block.settings.icon_2 != 'none' %}
                            {% unless block.settings.custom_icon_2 == blank and block.settings.another_icon_2 == blank and block.settings.icon_2 == 'another_icon' %}
                              <span class="inline-block min-w-[24px] lg:min-w-[36px] h-6 w-6 lg:h-9 lg:w-9">
                                {% if block.settings.custom_icon_2 == blank %}
                                  {% if block.settings.another_icon_2 != blank and block.settings.icon_2 == 'another_icon' %}
                                    {% render 'icon-new-alls', icon: block.settings.another_icon_2 %}
                                  {% else %}
                                    {% render 'icon-labels-bags', icon: block.settings.icon_2 %}
                                  {% endif %}
                                {% else %}
                                  {{ block.settings.custom_icon_2 }}
                                {% endif %}
                              </span>
                            {% endunless %}
                          {% endif %}
                          {% if block.settings.title_2 or block.settings.text_2 %}
                            <div>
                              <p class="empty:hidden">{{ block.settings.title_2 | escape }}</p>
                              {% if block.settings.text_link_2 != blank %}
                                <a href="{{ block.settings.text_link_2 }}"{% if block.settings.open_new_window_2 %} target="_blank"{% endif %}
                                  class="font-semibold p-break-words empty:hidden{% if block.settings.enable_text_link_2 %} text-[rgb(var(--colors-text-link))]{% endif %} hover-text-link nav-link relative"
                                >
                                  {{ block.settings.text_2 | escape }}
                                </a>
                              {% else %}
                                <p class="font-semibold p-break-words empty:hidden{% if block.settings.enable_text_link_2 %} text-[rgb(var(--colors-text-link))]{% endif %}">
                                  {{ block.settings.text_2 | escape }}
                                </p>
                              {% endif %} 
                            </div>
                          {% endif %}
                        </div>
                      {% endif %}
                      {% if block.settings.icon_3 != 'none' or block.settings.title_3 or block.settings.text_3 %}
                        <div class="mb-4 flex items-center gap-x-4">
                          {% if block.settings.icon_3 != 'none' %}
                            {% unless block.settings.custom_icon_3 == blank and block.settings.another_icon_3 == blank and block.settings.icon_3 == 'another_icon' %}
                              <span class="inline-block h-6 w-6 lg:h-9 lg:w-9 min-w-[24px] lg:min-w-[36px]">
                                {% if block.settings.custom_icon_3 == blank %}
                                  {% if block.settings.another_icon_3 != blank and block.settings.icon_3 == 'another_icon' %}
                                    {% render 'icon-new-alls', icon: block.settings.another_icon_3 %}
                                  {% else %}
                                    {% render 'icon-labels-bags', icon: block.settings.icon_3 %}
                                  {% endif %}
                                {% else %}
                                  {{ block.settings.custom_icon_3 }}
                                {% endif %}
                              </span>
                            {% endunless %}
                          {% endif %}
                          {% if block.settings.title_3 or block.settings.text_3 %}
                            <div>
                              <p class="empty:hidden">{{ block.settings.title_3 | escape }}</p>
                              {% if block.settings.text_link_3 != blank %}
                                <a href="{{ block.settings.text_link_3 }}"{% if block.settings.open_new_window_3 %} target="_blank"{% endif %}
                                  class="font-semibold p-break-words empty:hidden{% if block.settings.enable_text_link_3 %} text-[rgb(var(--colors-text-link))]{% endif %} hover-text-link nav-link relative"
                                >
                                  {{ block.settings.text_3 | escape }}
                                </a>
                              {% else %}
                                <p class="font-semibold p-break-words empty:hidden{% if block.settings.enable_text_link_3 %} text-[rgb(var(--colors-text-link))]{% endif %}">
                                  {{ block.settings.text_3 | escape }}
                                </p>
                              {% endif %}
                            </div>
                          {% endif %}
                        </div>
                      {% endif %}
                    {% endcapture %}
                    <div class="footer-main__block-content mt-6">
                      {{ contact_block_content }}
                    </div>
                    {%- if block.settings.show_social_icons and has_social_links -%}
                      <div class="social-row">
                        {% render 'toolbar', enable_footer: true, show_social_icons: block.settings.show_social_icons %}
                      </div>
                    {%- endif -%}
                  </div>
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {% liquid
        assign show_currency_block = false
        if section.settings.show_currency_selector and localization.available_countries.size > 0
          assign show_currency_block = true
        endif

        assign payment_types_source = section.settings.custom_payment | strip
        if payment_types_source == blank
          assign payment_types_source = shop.enabled_payment_types | join: ','
        endif
        if payment_types_source == blank
          assign payment_types_source = 'amazon,american_express,apple_pay,diners_club,discover,google_pay,master,shopify_pay,visa,paypal'
        endif

        assign payment_types_source = payment_types_source | downcase | remove: ' '
        assign payment_types_source = payment_types_source | replace: 'mastercard', 'master'
        assign payment_types_source = payment_types_source | replace: 'amex', 'american_express'
        assign payment_types_source = payment_types_source | replace: 'shop_pay', 'shopify_pay'
        assign enabled_payment_types = payment_types_source | split: ','
      %}
      {%- capture payment_icons_html -%}
        {%- for type in enabled_payment_types -%}
          {%- capture payment_icon -%}{{ type | payment_type_svg_tag }}{%- endcapture -%}
          {%- if payment_icon != blank -%}
            <li aria-hidden="true">{{ payment_icon }}</li>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {% liquid
        assign show_payment_block = false
        if section.settings.payment_enable and payment_icons_html != blank
          assign show_payment_block = true
        endif
      %}
      {%- if show_currency_block or show_payment_block -%}
        <div class="footer-bottom{% unless show_currency_block %} footer-bottom--payments-only{% endunless %}">
          {%- if show_currency_block -%}
            <div class="currency-block {{ class_rtl }}">
              <div class="footer-meta__selector">
                {%- render 'multi-selectors',
                  currency_selector: true,
                  locale_selector: false,
                  enable_footer: true,
                  selector_id_suffix: section.id
                -%}
              </div>
            </div>
          {%- endif -%}
          {%- if show_payment_block -%}
            <span class="sr-only" id="footer-payment-label-{{ section.id }}">Payment methods</span>
            <ul
              class="payment-row icon-payment"
              role="list"
              aria-labelledby="footer-payment-label-{{ section.id }}"
            >
              {{ payment_icons_html }}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.show_copyright or section.settings.show_powered -%}
        <div class="copyright-row{% unless show_currency_block or show_payment_block %} copyright-row--without-bottom{% endunless %} base-link p-break-words">
          {%- if section.settings.show_copyright -%}
            <div class="copyright-text">
              <span>&copy; {{ 'now' | date: "%Y" }}{% unless is_rtl %}, {% endunless %}</span>
              {{ shop.name | link_to: routes.root_url }}
              {%- if section.settings.add_copyright_text != blank -%}
                <div class="copyright-extra">
                  {{ section.settings.add_copyright_text }}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if section.settings.show_copyright and section.settings.show_powered -%}
            <span class="copyright-sep" aria-hidden="true">|</span>
          {%- endif -%}
          {%- if section.settings.show_powered -%}
            <div class="copyright-powered">{{ powered_by_link }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
  </div>
  {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
    <div class="x-pgw page-width pt-5 md:pt-3.5 md:pb-3 pb-2 change-position-popup text-center ltr
      {%- if section.settings.additional_layout == 'horizontal' %} lg:text-{{ section.settings.horizontal_position }} rtl:lg:text-{% if section.settings.horizontal_position == 'center' %}center{% elsif section.settings.horizontal_position == 'left' %}right{% else %}left{% endif -%}
      {%- else %} lg:text-center{% endif %}"
    >
      {% comment %} TODO: enable theme-check once `login_button` is accepted as valid filter {% endcomment %}
      {% # theme-check-disable %}
      {{ shop | login_button: action: 'follow' }}
      {% # theme-check-enable %}
    </div>
  {%- endif -%}
</footer>
